# Copy to .env and fill in. NEVER commit .env.
#
# Two separate Alpaca paper accounts:
#   - DEV  = testing account, used for Monday's dry run (§10)
#   - COMP = the brand-new $100,000 competition account, first traded Mon 09:30 ET
# Alpaca requires the competition account to be fresh; a reused account is
# not eligible for judging.

ALPACA_ACCOUNT=dev            # dev | comp   <- the only switch that matters

ALPACA_DEV_API_KEY=
ALPACA_DEV_SECRET_KEY=

ALPACA_COMP_API_KEY=
ALPACA_COMP_SECRET_KEY=

# Fails safe: the MCP server defaults to paper when unset.
ALPACA_PAPER_TRADE=true

# Least privilege. Valid names per the alpaca-mcp-server README; these five
# cover account, orders/positions, contracts, quotes/bars and chains.
# Dropped: watchlists, crypto-data, corporate-actions, news,
# fixed-income-data, locates. An invalid name here silently starves the
# server of tools rather than erroring, so do not guess at these.
ALPACA_TOOLSETS=account,trading,assets,stock-data,options-data

# --- LLM layer (§5 step 6). Optional: the agent trades without it. ---
# provider: featherless | anthropic | none
LLM_PROVIDER=featherless
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=
# Confirm against the hackathon's Featherless setup guide before Monday.
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
